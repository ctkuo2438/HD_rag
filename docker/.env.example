# Consumer settings for the released image. Copy this file to .env beside compose.yaml.
# Starting with that compose.yaml opts into paid calls when you submit a question.
# The image already contains the knowledge index and preset models.
OPENAI_API_KEY=

# Optional reranking: fill the key AND change the provider to cohere and API flag to 1.
# Leave these defaults to use RRF without Cohere charges.
COHERE_API_KEY=
HD_RAG_RERANK_PROVIDER=none
HD_RAG_REAL_RERANK_API=0
